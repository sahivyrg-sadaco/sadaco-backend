# SADACO Backend — environment configuration
# Copy this file to `.env` and fill in your values.

SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Supabase Postgres — use pooler (port 6543)
DATABASE_URL=postgresql://postgres:pass@db.xxx.supabase.co:6543/postgres

# CORS — comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Google Drive service account (full JSON as a single line string)
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
GOOGLE_DRIVE_ROOT_FOLDER_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz

# Alternative: path to a service-account JSON file on disk
# GOOGLE_DRIVE_SERVICE_ACCOUNT_FILE=/path/to/service-account.json
